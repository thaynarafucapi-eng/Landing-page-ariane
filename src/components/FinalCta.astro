---
import WhatsAppButton from './WhatsAppButton.astro';
---

<section id="contato" class="final-cta" aria-labelledby="final-title">
  <div class="final-cta__tree" aria-hidden="true"></div>
  <div class="container final-cta__inner">
    <h2 id="final-title">Cada criança merece ser compreendida em suas necessidades e potencialidades.</h2>
    <p>
      Converse com Ariane pelo WhatsApp para conhecer as possibilidades de atendimento e entender qual é o melhor
      próximo passo para o seu filho.
    </p>
    <WhatsAppButton label="Conversar pelo WhatsApp" placement="cta-final" variant="gold" size="lg" />
  </div>
</section>
